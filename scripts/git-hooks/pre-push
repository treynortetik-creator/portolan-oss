#!/bin/sh
# Refuses a push unless scripts/ci_local.py passed on every commit being pushed. Same check as
# the Claude Code hook (.claude/hooks/push_gate.py). Install: scripts/install_git_hooks.sh.
set -eu
top="$(git rev-parse --show-toplevel)"
gate="$top/.claude/hooks/push_gate.py"
[ -f "$gate" ] || { echo "pre-push: $gate is missing, so this push was not checked." >&2; exit 1; }
zero="0000000000000000000000000000000000000000"
status=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  (cd "$top" && python3 "$gate" --sha "$local_sha") || status=1
done
exit "$status"
