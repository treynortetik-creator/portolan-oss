# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string for this customer's database (spec sec 8:
# one database per customer). Local dev: `createdb portolan_dev`. Never a name starting
# with portolan_test: the test suite treats those as disposable (tests/guards.py).
DATABASE_URL=postgresql://localhost/portolan_dev

# AWS region and named CLI profile used for Bedrock model calls, S3
# originals, and everything else in "our AWS account" (spec sec 11).
AWS_REGION=us-east-1
AWS_PROFILE=portolan-dev

# --- Bedrock credentials in production (bug hunt 2026-09-18, P1 finding
# 6) ---
# AWS_PROFILE above is a *local dev* convenience -- it reads a named
# profile out of ~/.aws/credentials, which does not exist on a Railway
# (or any non-AWS) container. A deployment with LLM_PROVIDER=bedrock
# needs real IAM user credentials as plain environment variables instead
# -- boto3's default credential chain picks these up with no code change.
# Names only below; generate the actual key pair in IAM (least-privilege:
# bedrock:InvokeModel on the specific model ids EXTRACTION_MODEL/
# COMPARE_MODEL/STRONG_MODEL name) and set the real values only in
# Railway's own variable store, never here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=       # only if the IAM user requires STS-issued temporary credentials

# Which customer's data this process is touching. Not a DB tenant column
# (schema is one-database-per-customer); used by the metering wrapper and
# any script that needs to log which customer it ran for.
PORTOLAN_TENANT=demo

# --- LLM access (portolan/config.py, portolan/llm/) ---

# Which portolan.llm.get_llm() implementation to construct: "agent_sdk"
# (local dev -- routes through the Claude Agent SDK, which talks to Claude
# through the already-logged-in Claude Code CLI, no API key needed; run
# `claude` once interactively first if you haven't logged in -- see
# adr-001-language-and-stack.md "Local model access"), "bedrock" (AWS, spec
# sec 11), "anthropic" (first-party Messages API -- no CLI login, needs
# ANTHROPIC_API_KEY; for hosted deployments and for putting Claude on the
# bench alongside every other model), "openrouter" (needs
# OPENROUTER_API_KEY; one API for hundreds of models -- see EXTRACTION_MODEL
# below for the id format), or "fake" (tests only).
LLM_PROVIDER=agent_sdk

# --- portolan/llm/anthropic_api.py (llm_provider=anthropic) ---
# From console.anthropic.com. Never commit a real value.
ANTHROPIC_API_KEY=

# --- portolan/llm/openrouter.py (llm_provider=openrouter) ---
# From openrouter.ai/keys. Never commit a real value.
OPENROUTER_API_KEY=

# Optional provider routing preferences (JSON array of provider slugs, in
# preference order), e.g. ["anthropic","together"]. Unset (the default)
# lets OpenRouter route per its own defaults.
# OPENROUTER_PROVIDER_ORDER=

# Model keys/ids per use (spec sec 5.5: cheap models do first-pass
# extraction, Claude is reserved for merge compares, consolidation
# retries, report prose and chat). These are short Claude model names when
# llm_provider=agent_sdk or anthropic (see portolan/pricing.py for the keys
# they must match), full Bedrock model ids when llm_provider=bedrock (e.g.
# "amazon.nova-lite-v1:0", "anthropic.claude-haiku-4-5"), or OpenRouter
# model ids -- author/slug, passed through verbatim -- when
# llm_provider=openrouter (e.g. "anthropic/claude-haiku-4.5",
# "openai/gpt-5.6-luna", "qwen/qwen3.8-27b", "amazon/nova-lite-v1").
EXTRACTION_MODEL=claude-haiku-4-5
COMPARE_MODEL=claude-haiku-4-5
STRONG_MODEL=claude-sonnet-5

# Chat's own model, when it should differ from STRONG_MODEL (e.g. a
# cheaper/faster interactive model, or the OpenRouter id Railway bills
# through). Unset (the default) falls back to STRONG_MODEL -- and, when
# LLM_PROVIDER=agent_sdk specifically, a CHAT_MODEL that isn't a plain
# "claude-..." id (an OpenRouter "vendor/model" id inherited from a
# deployed .env, say) is ignored in favor of claude-sonnet-5, since the
# Agent SDK only ever talks to Claude (portolan/llm/agent_sdk.py).
# CHAT_MODEL=

# The chat composer's character cap (portolan.web.bounds.
# require_question_length). Owner verdict 2026-09-18: no visible counter
# in the UI, just a friendly 400 past this many characters.
# CHAT_QUESTION_MAX_CHARS=32000

# fastembed runs bge-large-en-v1.5 locally (1024-dim, matches Titan V2's
# dimension so dev and prod share one schema -- adr-001). "titan" is the
# Bedrock embedder; "fake" is for tests.
EMBED_PROVIDER=fastembed

# hnsw.ef_search for search()'s vector leg, set per query (1-1000; pgvector's
# own default is 40). Higher finds more of the true nearest chunks on a large
# graph and costs index reads; chosen from the ERB exam's sweep, 2026-09-23
# (01-spec/bench-erb-search-2026-09-22.md, "Production path").
# PORTOLAN_SEARCH_HNSW_EF_SEARCH=200

# search()'s local cross-encoder over its fused top PORTOLAN_SEARCH_RERANK_POOL
# notes: off, bge-reranker-v2-m3, qwen3-reranker-0.6b, ms-marco-minilm-l6 or
# jina-reranker-v1-turbo-en. Model files download on first use into
# FASTEMBED_CACHE_PATH (the embedding model's cache). Off by default: see
# 01-spec/bench-erb-search-2026-09-22.md, "Reranker and query routing".
# PORTOLAN_SEARCH_RERANK=off
# PORTOLAN_SEARCH_RERANK_POOL=30
# Per-query fusion weights from the keyword leg's coverage of the query.
# PORTOLAN_SEARCH_FUSION_ROUTING=false
# Recency from each note's newest claim date instead of its last write. Off by
# default: 01-spec/content-dates-2026-09-25.md.
# PORTOLAN_SEARCH_RECENCY_CONTENT_DATE=true

# Local file store standing in for S3 (spec sec 8). Only needs setting if
# you want it somewhere other than the repo.
# STORE_ROOT=var/store

# --- Auth (portolan/config.py, portolan/web/, portolan/mcp_server/) ---
# The web app refuses to start without the session secret, and, under
# PORTOLAN_WEB_AUTH=none, without the org key; the MCP HTTP transport refuses
# to build without the third. There is no working default for any of
# these -- generate a real random value for each, e.g. `openssl rand
# -hex 32`, and never reuse one across customers.

# The shared org login key readers type in at /login.
PORTOLAN_ORG_KEY=

# Signs the session cookie. A cookie forged with a guessable or reused
# secret reads the whole graph -- keep this as secret as a database
# password.
PORTOLAN_SESSION_SECRET=

# Gates the MCP server's streamable-HTTP transport (a hosted deployment).
# Not needed for the stdio transport (a local client like Claude Code or
# Claude Desktop) -- the process boundary is that transport's auth.
PORTOLAN_MCP_ORG_KEY=

# Optional. The deployment's own public https://host, e.g.
# https://portolan-acme.up.railway.app -- no trailing slash. When set,
# the hosted MCP server's `open_source` tool returns `original_url` as
# `<this>/originals/<slug>` (an absolute link into the web app's own
# reader-facing viewer); when unset, it falls back to the relative path
# `/originals/<slug>`. Never used by the stdio transport, which keeps
# returning the store's own path/URL (docs/mcp-hosted.md).
PORTOLAN_PUBLIC_URL=

# Optional: OAuth on /mcp for claude.ai and ChatGPT connectors (docs/mcp-hosted.md,
# "claude.ai and ChatGPT connectors (OAuth)"). Off unless the issuer is set; none of
# these is a secret. The resource defaults to PORTOLAN_PUBLIC_URL + /mcp.
# PORTOLAN_MCP_OAUTH_ISSUER=https://<your-authkit-domain>
# PORTOLAN_MCP_OAUTH_ORG_ID=org_...
# PORTOLAN_MCP_OAUTH_RESOURCE=
# PORTOLAN_MCP_OAUTH_REQUIRED_SCOPES=openid
# PORTOLAN_MCP_OAUTH_ORG_CLAIM=org_id
# PORTOLAN_MCP_OAUTH_JWKS_URL=

# Optional: web app sign-in with WorkOS AuthKit (portolan/web/signin.py,
# 01-spec/pilot-sign-in-2026-09-25.md). "none" (the default) keeps the shared org
# key above. "workos" needs the client ID, the API key (a secret: set it only in
# Railway's variable screen), PORTOLAN_PUBLIC_URL, and an organization or domains.
# The organization defaults to PORTOLAN_MCP_OAUTH_ORG_ID.
# PORTOLAN_WEB_AUTH=none
# PORTOLAN_WORKOS_CLIENT_ID=
# PORTOLAN_WORKOS_API_KEY=
# PORTOLAN_WEB_AUTH_ORG_ID=
# PORTOLAN_WEB_AUTH_ALLOWED_DOMAINS=
# Emails that may open /admin/usage and /admin/people (comma-separated).
# PORTOLAN_ADMIN_EMAILS=

# Secure by default -- the session cookie is only ever sent back over
# HTTPS. The one sanctioned reason to turn this off is local development
# against plain http://127.0.0.1, where a browser won't attach a
# Secure-flagged cookie at all. Never set this to false for anything
# reachable over a real network.
# PORTOLAN_COOKIE_SECURE=true

# Off by default (review finding F9/F15): FastAPI's own /docs, /redoc,
# /openapi.json hand over the whole route and parameter surface. When
# turned on for local development, all three still require a session.
# PORTOLAN_ENABLE_API_DOCS=false
TYPESAFE_API_KEY= # optional, TypeSafe AI (Jev) typed-decision judge, see var/jev-typesafe-brief-2026-09-16.md

# --- Container role (docker/entrypoint.sh, portolan/config.py) ---
# Bug hunt 2026-09-18, P1 finding 4: PORTOLAN_ROLE was read by
# docker/entrypoint.sh but documented nowhere -- an unset/dropped value
# used to fall through to the image's CMD (the test suite), which ran
# once and exited while nothing served the port. Defaults to "web" now,
# both here and in docker/entrypoint.sh's own case statement; an unknown
# value exits the container non-zero with a clear message rather than
# falling through to anything.
# PORTOLAN_ROLE=web          # web | worker | migrate | test
# PORTOLAN_CONNECTOR=file    # worker role only: which connector's pipeline to poll
# PORTOLAN_WORKER_POLL_SECONDS=300  # worker role only: seconds between poll cycles

# --- Database connection pool (portolan/web/app.py, bug hunt 2026-09-18
# P0 finding 1) ---
# Sizes the psycopg_pool.ConnectionPool the web app opens at startup.
# max_size is deliberately well under uvicorn's default worker-thread
# count -- Postgres connections, not threads, should be the throughput
# knob.
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=10

# --- External signals (portolan/signals, 01-spec/external-signals-2026-09-23.md) ---
# Off by default. When true, `python -m portolan.signals scan` reads the
# per-account feeds and web pages in `signal_targets`, and the weekly
# report adds a "Public signals this week" section.
# PORTOLAN_EXTERNAL_SIGNALS=false
# PORTOLAN_EXTERNAL_SIGNALS_MODEL=openai/gpt-5.6-luna
# PORTOLAN_EXTERNAL_SIGNALS_USER_AGENT=PortolanSignals/0.1 (weekly public-page check; respects robots.txt)

# --- Pilot activity log (portolan/activity, migration 0037) ---
# Page views, chat questions, citation clicks, review decisions, action
# confirms and email opens/clicks older than this many days are deleted at
# web startup and by `python -m portolan.activity purge`. 0 keeps every row.
# `python -m portolan.activity delete-user "<name>"` removes one person's rows.
# PORTOLAN_ACTIVITY_RETENTION_DAYS=180
